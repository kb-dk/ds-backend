<?xml version='1.0' encoding='utf-8'?>
<Context override="true" docBase="/app/tomcat-apps/ds-present.war">

    <Environment name="ds-present-logback-config"
        value="/app/conf/ds-present-logback.xml"
        type="java.lang.String"
        override="false"/>
    <!-- ServiceConfig loads a single YAML file (no more behaviour/kb-origins/environment globbing - the former
         ds-present-kb-origins.yaml has been folded into ds-present-behaviour.yaml). This file is identical on
         every server - do not edit a deployed copy directly. Nested tree values (imageservers, storages,
         origins, ...) are overridden per environment via the application-properties-config file below instead,
         exactly like every other setting - see ds-present-application.properties.SAMPLE. -->
    <Environment name="application-config"
        value="${user.home}/services/conf/ds-present-behaviour.yaml"
        type="java.lang.String"
        override="false"/>             
         <!-- Optional devops/operations properties override file - carries secrets such as OAI target credentials
         and the Kaltura admin secret, kept entirely outside git. Distinct per service/WAR, since a Tomcat
         instance hosting several WARs (as the development server does) shares one JVM working directory:
         SmallRye's own implicit 'config/application.properties' convention can't tell services apart, so this
         explicit per-service path is used instead.-->         
    <Environment name="application-properties-config"
        value="${user.home}/services/conf/ds-present-application.properties"
        type="java.lang.String"
        override="false"/>

</Context>
