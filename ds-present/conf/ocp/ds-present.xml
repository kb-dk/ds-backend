<?xml version='1.0' encoding='utf-8'?>
<Context override="true" docBase="/app/tomcat-apps/ds-present.war">

    <Environment name="ds-present-logback-config"
        value="/app/conf/ds-present-logback.xml"
        type="java.lang.String"
        override="false"/>
    <!-- Note: this is deliberately still a glob, unlike the other ds-backend services. ServiceConfig's nested
         YAML tree (getConfig()) merges multiple files (behaviour + kb-origins + an environment-specific file, in
         alphanumeric order) since it backs the origins/storages/views/transformers object graph, which has no
         flat-property equivalent - see ServiceConfig's class javadoc. -->
    <Environment name="application-config"
        value="/app/conf/ds-present*.yaml"
        type="java.lang.String"
        override="false"/>
    <!-- Optional devops/operations properties override file - carries secrets, kept entirely outside git. Only
         affects ServiceConfig.getFlatConfig() (simple/scalar settings), not the nested YAML tree above.
         Distinct per service/WAR, since a Tomcat instance hosting several WARs (as the development server does)
         shares one JVM working directory: SmallRye's own implicit 'config/application.properties' convention
         can't tell services apart, so this explicit per-service path is used instead.
         See ds-storage/SMALLRYE_CONFIG_MIGRATION.md. -->
    <Environment name="application-properties-config"
        value="${user.home}/services/conf/ds-present-application.properties"
        type="java.lang.String"
        override="false"/>

</Context>

