<?xml version="1.0"?>
<!DOCTYPE Configure PUBLIC "-//Jetty//Configure//EN" "http://www.eclipse.org/jetty/configure_10_0.dtd">
<Configure class="org.eclipse.jetty.webapp.WebAppContext">

    <New id="logback" class="org.eclipse.jetty.plus.jndi.EnvEntry">
        <Arg>${project.artifactId}-logback-config</Arg>
        <Arg type="java.lang.String">
            ${basedir}/target/jetty-res/bff-logback.xml
        </Arg>
        <Arg type="boolean">true</Arg>
    </New>

    <New id="config" class="org.eclipse.jetty.plus.jndi.EnvEntry">
        <!-- ServiceConfig loads a single YAML file (no more base/environment globbing). -->
        <Arg>application-config</Arg>
        <Arg type="java.lang.String">
            ${basedir}/conf/${project.artifactId}-base.yaml
        </Arg>
        <Arg type="boolean">true</Arg>
    </New>

    <!-- Optional devops/operations properties override file. Not present under conf/ during normal test runs,
         so ServiceConfig logs that it is missing and continues with only the YAML file above - see
         ServiceConfig's class javadoc. -->
    <New id="propertiesConfig" class="org.eclipse.jetty.plus.jndi.EnvEntry">
        <Arg>application-properties-config</Arg>
        <Arg type="java.lang.String">
            ${basedir}/conf/${project.artifactId}-application.properties
        </Arg>
        <Arg type="boolean">true</Arg>
    </New>

</Configure>