<?xml version='1.0' encoding='utf-8'?>
<Context override="true" docBase="/app/tomcat-apps/bff.war">

    <Environment name="logback-config"
        value="/app/conf/bff-logback.xml"
        type="java.lang.String"
        override="false"/>
    <!-- ServiceConfig loads a single YAML file (no more base/environment globbing). -->
    <Environment name="application-config"
        value="/app/conf/bff-base.yaml"
        type="java.lang.String"
        override="false"/>
    <!-- Optional devops/operations properties override file - carries secrets such as keycloak.secret and
         secretSalt, kept entirely outside git. See ds-storage/SMALLRYE_CONFIG_MIGRATION.md. -->
    <Environment name="application-properties-config"
        value="/app/conf/bff-application.properties"
        type="java.lang.String"
        override="false"/>

</Context>

