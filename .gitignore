# We use pom.xml as the source of truth and don't rely on a specific IDE
.idea/
aegis/
.env
.git

## Contains KB-internal information for testing
# These config files should NEVER be in git, as they can contain passwords or information that must not be public
*oai_harvest.conf
*kb-internal-test.yaml
*internal-test-setup.yaml
*environment.yaml
*local.yaml
*security-salt.yaml
*unittest.yaml
*integration-test.yaml
*NoisyPillars.mp3
*/src/test/resources/xml/*.xml
*/src/test/resources/rightsModuleMigratedData/*
*internal_test_files/

# SmallRye Config local/operational override files - may contain secrets (e.g. db password).
# See <module>/config/application.properties.SAMPLE for the template.
**/config/application.properties

# Exception: ds-shared is a library module, never deployed on its own, and its config/application.properties
# holds only dummy values for ApplicationPropertiesOverrideTest - no real secret. It is committed so that test
# works on every checkout without a manual copy-the-.SAMPLE step first; application.properties.SAMPLE has been
# removed from ds-shared as a result (unlike every other module, where the .SAMPLE stays the template and the
# real file must never be committed).
!ds-shared/config/application.properties

# SmallRye Config per-service devops/operations override files - may contain secrets (e.g. db password).
# The real files live outside this repo (e.g. ${user.home}/services/conf/<service>-application.properties);
# this only guards against one ending up committed if created locally for testing.
# See <module>/conf/<service>-application.properties.SAMPLE for the template.
*-application.properties

# compiled files
*.class

# Package Files
*.jar
*.iws
*.war
*.ear
*.iml
*.ipr

# Maven build files
target/

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
.project
.settings/
.openapi-generator/
.classpath
.openapi-generator-ignore

# mvn release:prepare
release.properties
pom.xml.releaseBackup
pom.xml.tag
pom.xml.next