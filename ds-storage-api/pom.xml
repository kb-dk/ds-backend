<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dk.kb.dsparent</groupId>
        <artifactId>ds-parent</artifactId>
        <version>100.0.0-SNAPSHOT</version>
    </parent>
    <!-- Human-readable name, uppercase and spaces welcome -->
    <name>ds-storage-api</name>
    <groupId>dk.kb.storage</groupId>
    <artifactId>ds-storage-api</artifactId>
    <version>100.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <description>
        The ds-storage contract: the OpenAPI specification, the generated DTOs and DsStorageClient. This module contains no service implementation and depends on no other
        ds service, so it builds on its own in seconds. Consumers depend on this, never on the war.
    </description>
    <scm>
        <url>https://github.com/kb-dk/ds-backend</url>
        <connection>scm:git:git@github.com:kb-dk/ds-backend.git</connection>
        <developerConnection>scm:git:git@github.com:kb-dk/ds-backend.git</developerConnection>
        <tag>HEAD</tag>
    </scm>
    <licenses>
        <license>
            <name>${license.name}</name>
            <url>${license.url}</url>
        </license>
    </licenses>
    <properties>
        <!-- The generated client and DTOs trip forbiddenapis; the service module still checks its own code. -->
        <api.check.phase>none</api.check.phase>
        <license.name>Apache License, Version 2.0</license.name>
        <license.url>https://www.apache.org/licenses/LICENSE-2.0.txt</license.url>
        <timestamp>${maven.build.timestamp}</timestamp>
        <project.package>dk.kb.storage</project.package>
        <!-- NOTE: the spec's operation tags are now the literal string "ds-storage", not a
             Maven placeholder. Those tags decide the generated interface names (tag "ds-storage"
             -> DsStorageApi), so when the spec used ${project.name} the Java types silently
             followed the module's display name: moving the spec into a module called
             ds-storage-api renamed them to DsStorageApiApi and orphaned every impl class. The
             name of an API is a fact about the contract, not about the module that builds it, so
             it is written out in the spec. -->
    </properties>
    <!-- A contract's dependencies are part of its API: every consumer gets them transitively.
         So this list is only what the classes in this jar reference directly (checked with
         `jdeps -summary` against the built jar), and nothing that is already there through
         ds-shared: cxf-rt-frontend-jaxrs (-> javax.ws.rs), jackson-databind / -annotations /
         -datatype-jsr310, jackson-databind-nullable, commons-io, slf4j-api and the javax.xml.bind API
         all arrive that way. The service module declares its own runtime stack itself.
         Before the split, consumers got the same effect with a wildcard <exclusion> on the
         api-classifier jar; here the contract simply does not carry more than it needs. -->
    <dependencies>
        <dependency>
            <groupId>dk.kb.dsshared</groupId>
            <artifactId>ds-shared</artifactId>
            <version>100.0.0-SNAPSHOT</version>
        </dependency>
        <!-- @Api/@ApiModel(Property) in generated code, @AuthorizationScope in KBAuthorization. Same version swagger-jaxrs uses. -->
        <dependency>
            <groupId>io.swagger</groupId>
            <artifactId>swagger-annotations</artifactId>
            <version>1.5.24</version>
        </dependency>
        <!-- URIBuilder in the client. Version from the parent pom. -->
        <dependency>
            <groupId>org.apache.httpcomponents.core5</groupId>
            <artifactId>httpcore5</artifactId>
        </dependency>
        <!-- javax.validation annotations in the generated interfaces and DTOs. -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>2.0.2</version>
        </dependency>
        <!-- javax.annotation.Nullable / Nonnull in the generated code. -->
        <dependency>
            <groupId>com.google.code.findbugs</groupId>
            <artifactId>jsr305</artifactId>
            <version>3.0.2</version>
        </dependency>
        <!-- Compile-only, so `provided`: the generated interfaces import javax.servlet.http.* and
             io.swagger.jaxrs.PATCH without using them. Unused imports leave no trace in the
             bytecode, which is why jdeps did not list these, but javac still needs them. Provided
             scope is not transitive, so consumers do not inherit either jar. -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.swagger</groupId>
            <artifactId>swagger-jaxrs</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
    <build>
        <resources>
            <!-- The spec is filtered into target/classes, then fed to the generator below and
                 packaged into this jar so the service module can unpack it. -->
            <resource>
                <directory>src/main/openapi</directory>
                <filtering>true</filtering>
            </resource>
            <!-- The mustache templates travel with the contract so the service module does not
                 need its own copy; they land under openapi-templates/ inside this jar. -->
            <resource>
                <directory>src/main/templates</directory>
                <targetPath>openapi-templates</targetPath>
                <filtering>false</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                </configuration>
                <executions>
                    <execution>
                        <!-- Ensure the spec is filtered into target/classes BEFORE the generator runs. -->
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>resources</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>4.3.1</version>
                <configuration>
                    <generatorName>jaxrs-cxf-extended</generatorName>
                    <inputSpec>${project.build.outputDirectory}/openapi.yaml</inputSpec>
                    <modelNameSuffix>Dto</modelNameSuffix>
                    <generateSupportingFiles>false</generateSupportingFiles>
                    <generateApiTests>false</generateApiTests>
                    <generateModelDocumentation>true</generateModelDocumentation>
                    <generateApis>true</generateApis>
                    <output>${project.basedir}</output>
                    <templateDirectory>src/main/templates/</templateDirectory>
                    <configOptions>
                        <sourceFolder>target/generated-sources</sourceFolder>
                        <useSwaggerFeature>true</useSwaggerFeature>
                        <useSwaggerUI>true</useSwaggerUI>
                        <apiPackage>${project.package}.api</apiPackage>
                        <modelPackage>${project.package}.model</modelPackage>
                        <dateLibrary>threetenbp</dateLibrary>
                        <implFolder>src/main/java</implFolder>
                        <invokerPackage>${project.package}</invokerPackage>
                    </configOptions>
                    <packageName>${project.package}</packageName>
                </configuration>
                <executions>
                    <execution>
                        <id>v1: generate api classes</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.build.outputDirectory}/ds-storage-openapi_v1.yaml</inputSpec>
                            <ignoreFileOverride>
                                ${project.basedir}/.openapi-codegen-ignore-api
                            </ignoreFileOverride>
                            <configOptions>
                                <apiPackage>${project.package}.api.v1</apiPackage>
                                <modelPackage>${project.package}.model.v1</modelPackage>
                                <generateOperationBody>false</generateOperationBody>
                                <sourceFolder>target/generated-sources</sourceFolder>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>add-generated-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/target/generated-sources</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
