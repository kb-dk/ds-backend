<assembly>
  <id>distribution</id>
  <formats>
    <format>tar.gz</format>
  </formats>

  <files>
    <!-- This build's flyway zip, identical to the one published to Nexus, so the
         migrations ship with the war they were built against. Produced by the
         'flyway-sql' execution, which must run before this one. -->
    <file>
      <source>target/${project.build.finalName}-flyway.zip</source>
      <outputDirectory>/</outputDirectory>
      <fileMode>0644</fileMode>
    </file>
    <file>
      <source>conf/ocp/ds-license.xml</source>
      <outputDirectory>/</outputDirectory>
      <destName>ds-license.xml.SAMPLE</destName>
    </file>
  </files>

  <dependencySets>
    <dependencySet>
      <outputDirectory>lib</outputDirectory>
      <directoryMode>0755</directoryMode>
      <fileMode>0644</fileMode>
      <includes>
        <include>*:war</include>
      </includes>
    </dependencySet>
  </dependencySets>

  <fileSets>
    <fileSet>
      <outputDirectory>conf</outputDirectory>
      <directoryMode>0755</directoryMode>
      <fileMode>0644</fileMode>
      <directory>conf</directory>
      <excludes>
	      <exclude>ocp/</exclude>
	      <exclude>ds-license-local.yaml</exclude>
      </excludes>
    </fileSet>
    <fileSet>
      <outputDirectory>.</outputDirectory>
      <directoryMode>0755</directoryMode>
      <fileMode>0644</fileMode>
      <includes>
          <include>CHANGELOG.md</include>
          <include>README.md</include>
      </includes>
    </fileSet>
    <fileSet>
      <directory>target/ds-license-${version}</directory>
      <outputDirectory>.</outputDirectory>
      <directoryMode>0755</directoryMode>
      <fileMode>0644</fileMode>
      <includes>
        <include>ds-license.build.properties</include>
      </includes>
    </fileSet>
  </fileSets>


</assembly>

