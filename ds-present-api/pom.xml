        <dependency>
            <groupId>org.apache.solr</groupId>
            <artifactId>solr-test-framework</artifactId>
            <version>9.4.1</version>
            <scope>test</scope>
            <exclusions>
                <!-- Solves the "multiple slf bindings" warning -->
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
