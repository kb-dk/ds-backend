    <!-- Human-readable name, uppercase and spaces welcome -->
    <name>ds-present-api</name>
    <groupId>dk.kb.present</groupId>
    <artifactId>ds-present-api</artifactId>
    <version>100.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <description>
        The ds-present contract: the OpenAPI specification, the generated DTOs and DsPresentClient. This module contains no service implementation and depends on no other
        ds service, so it builds on its own in seconds. Consumers depend on this, never on the war.
    </description>
    <scm>
        <url>https://github.com/kb-dk/ds-backend</url>
        <connection>scm:git:git@github.com:kb-dk/ds-backend.git</connection>
        <developerConnection>scm:git:git@github.com:kb-dk/ds-backend.git</developerConnection>
        <tag>HEAD</tag>
    </scm>
    <licenses>
        <license>
            <name>${license.name}</name>
            <url>${license.url}</url>
        </license>
    </licenses>
    <properties>
        <!-- The generated client and DTOs trip forbiddenapis; the service module still checks its own code. -->
        <api.check.phase>none</api.check.phase>
        <license.name>Apache License, Version 2.0</license.name>
        <license.url>https://www.apache.org/licenses/LICENSE-2.0.txt</license.url>
        <timestamp>${maven.build.timestamp}</timestamp>
        <project.package>dk.kb.present</project.package>
    </properties>
