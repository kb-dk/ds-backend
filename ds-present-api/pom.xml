            <groupId>dk.kb.dsshared</groupId>
            <artifactId>ds-shared</artifactId>
            <version>100.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <!-- DsPresentClient returns dk.kb.storage.model.v1.DsRecordDto, so the ds-present
                 contract genuinely references the ds-storage contract. Contract-to-contract is
                 fine: what a contract must never depend on is a SERVICE module. The graph stays
                 acyclic - ds-storage-api depends on nothing but ds-shared. -->
            <groupId>dk.kb.storage</groupId>
            <artifactId>ds-storage-api</artifactId>
            <version>100.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>3.1.8</version>
        </dependency>
