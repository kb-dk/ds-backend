# Devops/operations override file for ds-datahandler.
#
# Copy this to 'ds-datahandler-application.properties' (same folder, without the '.SAMPLE' suffix) and fill in
# your own values, then point the Tomcat context environment entry 'application-properties-config' at it
# (see conf/ocp/ds-datahandler.xml) - in production this is typically
# ${user.home}/services/conf/ds-datahandler-application.properties, a plain file living entirely outside this
# git repository.
#
# This file (unlike SmallRye's own implicit 'config/application.properties' convention, see
# config/application.properties.SAMPLE) is read from the exact path configured for THIS service alone, so it is
# safe to use even when several WAR files share one Tomcat instance (as the development server does) - each
# service gets its own distinct 'application-properties-config' entry and its own distinct file.
#
# This file must never be committed to git - it is the intended place for secrets, most importantly the
# database password, the Kaltura admin secret and the OAI target credentials.
#
# Any key present in ds-datahandler-behaviour.yaml can be overridden here, using the same dotted path. Only the
# keys below are the ones commonly overridden per environment/operator - uncomment and set the ones you need.

# db.url=jdbc:postgresql://localhost:5432/ds-datahandler
# db.driver=org.postgresql.Driver
# db.username=ds_datahandler_user
# db.password=changeme
# db.connectionPoolSize=10

# Not used - use kaltura.token/kaltura.tokenId instead - but overridable here if ever needed.
# kaltura.adminSecret=changeme

# oaiTargets is a list (see ds-datahandler-behaviour.yaml): individual fields of a single target can be
# overridden here by index, as long as the index matches the target's position in the YAML list. This is the
# normal way to inject real OAI harvest credentials without putting them in git.
# oaiTargets[0].user=changeme
# oaiTargets[0].password=changeme

# openapi.serverurl=http://localhost:9071/ds-datahandler/v1
