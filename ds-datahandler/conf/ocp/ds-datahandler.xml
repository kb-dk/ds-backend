<?xml version='1.0' encoding='utf-8'?>
<Context override="true" docBase="/app/tomcat-apps/ds-datahandler.war">

    <Environment name="ds-datahandler-logback-config"
        value="/app/conf/ds-datahandler.logback.xml"
        type="java.lang.String"
        override="false"/>
    <!-- ServiceConfig loads a single YAML file (no more behaviour/environment globbing). -->
    <Environment name="application-config"
        value="${user.home}/services/conf/ds-datahandler-behaviour.yaml"
        type="java.lang.String"
        override="false"/>
    <!-- Optional devops/operations properties override file - carries secrets such as OAI target credentials
         and the Kaltura admin secret, kept entirely outside git. Distinct per service/WAR, since a Tomcat
         instance hosting several WARs (as the development server does) shares one JVM working directory:
         SmallRye's own implicit 'config/application.properties' convention can't tell services apart, so this
         explicit per-service path is used instead. See ds-storage/SMALLRYE_CONFIG_MIGRATION.md. -->
    <Environment name="application-properties-config"
        value="${user.home}/services/conf/ds-datahandler-application.properties"
        type="java.lang.String"
        override="false"/>

</Context>

