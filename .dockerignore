# .git changes on every commit. Nothing in the image build reads it (git-commit-id
# is skipped), and sending it would only make every build context bigger.
.git/

.idea/
aegis/
*.iml
.env
.env.template
docker-compose.yml
Jenkinsfile
Jenkinsfile.release
README.md
CHANGELOG.md

# Maven build output, in every module. `**/` is required: like `*.log` below, a
# bare `target/` only matches the top level, which let each module's local
# target/ (wars, jars, classes) into the build context. The service stages copy
# their whole module directory, so a local `mvn install` then invalidated that
# service's image build even when no source had changed.
**/target/

## Contains KB-internal information for testing
# These config files should NEVER be in git, as they can contain passwords or information that must not be public
**oai_harvest.conf
**kb-internal-test.yaml
**internal-test-setup.yaml
**environment.yaml
**local.yaml
**unittest.yaml
**integration-test.yaml
**NoisyPillars.mp3
**/src/test/resources/rightsModuleMigratedData/*
**/internal_test_files/

# compiled files
*.class

# Package Files
*.jar
*.iws
*.war
*.ear
*.ipr

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
.project
.settings/
.openapi-generator/
.classpath
.openapi-generator-ignore

# Runtime logs from local runs. Each service build stage copies its whole module
# directory, so without this a log rewritten by a local run would invalidate that
# service's build cache and end up inside a build layer. `**/` is needed here:
# unlike .gitignore, a bare `*.log` in .dockerignore only matches the top level.
**/*.log
