# Local override file for ds-shared's own test suite (see dk.kb.util.config.ApplicationPropertiesOverrideTest),
# demonstrating SmallRye Config's implicit 'config/application.properties' convention - the same one every
# module's production ServiceConfig relies on (see <module>/config/application.properties.SAMPLE for the
# per-service equivalent, where this matters for real deployments).
#
# Copy this file to 'application.properties' (same folder, without the '.SAMPLE' suffix) to make
# ApplicationPropertiesOverrideTest exercise the override; without it, that one test is skipped, not failed.
#
# This file must never be committed to git - see the repository's '**/config/application.properties'
# .gitignore rule.

db.password=dummy-test-password
db.connectionPoolSize=77

# Indexed-property syntax works in a plain .properties file exactly as it does in YAML or any other config
# source: each line below overrides only that one nested field of that one oaiTargets list entry, leaving
# every other field on both entries (name, url, datasource, ...) untouched, still coming from the YAML.
oaiTargets[0].password=elephant
oaiTargets[1].password=mountain
